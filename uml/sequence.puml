@startuml
!include _style.iuml
skinparam sequenceMessageAlign left
skinparam maxMessageSize 260
actor "Агент" as A
participant "ApplicationsPanel\n(клиент, Swing)" as UI
participant "ClientHandler\n(поток пула)" as H
participant "CommandDispatcher" as D
participant "ApplicationService" as S
participant "PremiumCalculator" as PC
participant "DAO" as DAO
database "PostgreSQL" as DB
A -> UI : выбрать заявку, указать дату\nначала, «Одобрить и оформить полис»
UI -> H : Request(APPROVE_APPLICATION,\napplicationId, startDate)
activate H
H -> D : dispatch(session, request)
activate D
D -> D : проверка авторизации\nи роли AGENT
D -> S : approve(agentId, applicationId, startDate)
activate S
S -> DAO : inTransaction: lockById(applicationId)
DAO -> DB : SELECT ... FOR UPDATE
alt заявка уже рассмотрена
  S --> D : BusinessRuleException
  D --> H : исключение
  H --> UI : Response.error(«Заявка уже рассмотрена»)
else заявка в статусе «На рассмотрении»
  S -> DAO : клиент, вид страхования,\nчисло выплат за 2 года
  DAO -> DB : SELECT ...
  S -> PC : calculate(type, application,\nclient, startDate, claims)
  activate PC
  PC --> S : PremiumQuote (премия, франшиза)
  deactivate PC
  S -> DAO : PolicyDao.insert, PaymentDao.insertAll\n(график взносов), ApplicationDao.decide
  DAO -> DB : INSERT/UPDATE ... COMMIT
  S --> D : Policy
  deactivate S
  D --> H : Response.ok(«Договор оформлен», policy)
  deactivate D
  H --> UI : Response
  deactivate H
  UI --> A : номер полиса, премия,\nпериод действия
end
@enduml
