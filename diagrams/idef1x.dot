digraph G {
graph [rankdir=LR, splines=ortho, nodesep=0.6, ranksep=1.3, forcelabels=true, pad=0.3, fontname="Liberation Serif"];
node [shape=plaintext, fontname="Liberation Serif", fontsize=13];
edge [fontname="Liberation Serif", fontsize=12, arrowhead=dot, arrowtail=none, arrowsize=0.9, penwidth=1.3];
"roles" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>roles</B></TD></TR><TR><TD><TABLE PORT="b" BORDER="1.5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT">id</TD></TR><HR/><TR><TD ALIGN="LEFT">name</TD></TR></TABLE></TD></TR></TABLE>>];
"users" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>users</B></TD></TR><TR><TD><TABLE PORT="b" BORDER="1.5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT">id</TD></TR><HR/><TR><TD ALIGN="LEFT">login</TD></TR><TR><TD ALIGN="LEFT">password_hash</TD></TR><TR><TD ALIGN="LEFT">salt</TD></TR><TR><TD ALIGN="LEFT">role_id (FK)</TD></TR><TR><TD ALIGN="LEFT">is_blocked</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR></TABLE></TD></TR></TABLE>>];
"clients" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>clients</B></TD></TR><TR><TD><TABLE PORT="b" BORDER="1.5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT">id</TD></TR><HR/><TR><TD ALIGN="LEFT">user_id (FK)</TD></TR><TR><TD ALIGN="LEFT">last_name</TD></TR><TR><TD ALIGN="LEFT">first_name</TD></TR><TR><TD ALIGN="LEFT">patronymic</TD></TR><TR><TD ALIGN="LEFT">birth_date</TD></TR><TR><TD ALIGN="LEFT">passport_no</TD></TR><TR><TD ALIGN="LEFT">phone</TD></TR><TR><TD ALIGN="LEFT">address</TD></TR></TABLE></TD></TR></TABLE>>];
"agents" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>agents</B></TD></TR><TR><TD><TABLE PORT="b" BORDER="1.5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT">id</TD></TR><HR/><TR><TD ALIGN="LEFT">user_id (FK)</TD></TR><TR><TD ALIGN="LEFT">last_name</TD></TR><TR><TD ALIGN="LEFT">first_name</TD></TR><TR><TD ALIGN="LEFT">patronymic</TD></TR><TR><TD ALIGN="LEFT">position</TD></TR><TR><TD ALIGN="LEFT">hire_date</TD></TR><TR><TD ALIGN="LEFT">commission_rate</TD></TR></TABLE></TD></TR></TABLE>>];
"insurance_types" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>insurance_types</B></TD></TR><TR><TD><TABLE PORT="b" BORDER="1.5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT">id</TD></TR><HR/><TR><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT">category</TD></TR><TR><TD ALIGN="LEFT">description</TD></TR><TR><TD ALIGN="LEFT">base_rate</TD></TR><TR><TD ALIGN="LEFT">min_sum</TD></TR><TR><TD ALIGN="LEFT">max_sum</TD></TR><TR><TD ALIGN="LEFT">max_term_months</TD></TR><TR><TD ALIGN="LEFT">is_active</TD></TR></TABLE></TD></TR></TABLE>>];
"applications" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>applications</B></TD></TR><TR><TD><TABLE PORT="b" BORDER="1.5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT">id</TD></TR><HR/><TR><TD ALIGN="LEFT">client_id (FK)</TD></TR><TR><TD ALIGN="LEFT">type_id (FK)</TD></TR><TR><TD ALIGN="LEFT">agent_id (FK)</TD></TR><TR><TD ALIGN="LEFT">requested_sum</TD></TR><TR><TD ALIGN="LEFT">term_months</TD></TR><TR><TD ALIGN="LEFT">franchise_percent</TD></TR><TR><TD ALIGN="LEFT">installments</TD></TR><TR><TD ALIGN="LEFT">object_description</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">decision_comment</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR><TR><TD ALIGN="LEFT">decided_at</TD></TR></TABLE></TD></TR></TABLE>>];
"policies" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>policies</B></TD></TR><TR><TD><TABLE PORT="b" BORDER="1.5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT">id</TD></TR><HR/><TR><TD ALIGN="LEFT">policy_number</TD></TR><TR><TD ALIGN="LEFT">application_id (FK)</TD></TR><TR><TD ALIGN="LEFT">client_id (FK)</TD></TR><TR><TD ALIGN="LEFT">agent_id (FK)</TD></TR><TR><TD ALIGN="LEFT">type_id (FK)</TD></TR><TR><TD ALIGN="LEFT">insured_sum</TD></TR><TR><TD ALIGN="LEFT">premium</TD></TR><TR><TD ALIGN="LEFT">franchise</TD></TR><TR><TD ALIGN="LEFT">start_date</TD></TR><TR><TD ALIGN="LEFT">end_date</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">created_at</TD></TR><TR><TD ALIGN="LEFT">terminated_at</TD></TR><TR><TD ALIGN="LEFT">refund_amount</TD></TR></TABLE></TD></TR></TABLE>>];
"payments" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>payments</B></TD></TR><TR><TD><TABLE PORT="b" BORDER="1.5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" style="rounded"><TR><TD ALIGN="LEFT">policy_id (FK)</TD></TR><TR><TD ALIGN="LEFT">installment_no</TD></TR><HR/><TR><TD ALIGN="LEFT">amount</TD></TR><TR><TD ALIGN="LEFT">due_date</TD></TR><TR><TD ALIGN="LEFT">paid_date</TD></TR></TABLE></TD></TR></TABLE>>];
"claims" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>claims</B></TD></TR><TR><TD><TABLE PORT="b" BORDER="1.5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT">id</TD></TR><HR/><TR><TD ALIGN="LEFT">policy_id (FK)</TD></TR><TR><TD ALIGN="LEFT">incident_date</TD></TR><TR><TD ALIGN="LEFT">report_date</TD></TR><TR><TD ALIGN="LEFT">description</TD></TR><TR><TD ALIGN="LEFT">damage_amount</TD></TR><TR><TD ALIGN="LEFT">assessed_damage</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR><TR><TD ALIGN="LEFT">payout_amount</TD></TR><TR><TD ALIGN="LEFT">agent_id (FK)</TD></TR><TR><TD ALIGN="LEFT">decision_comment</TD></TR><TR><TD ALIGN="LEFT">decided_at</TD></TR></TABLE></TD></TR></TABLE>>];
"roles":b -> "users":b [style=dashed, xlabel=" определяет ", headlabel="P", labeldistance=1.6, labelangle=35];
"users":b -> "clients":b [style=dashed, xlabel=" является ", headlabel="Z", labeldistance=1.6, labelangle=35];
"users":b -> "agents":b [style=dashed, xlabel=" является ", headlabel="Z", labeldistance=1.6, labelangle=35];
"clients":b -> "applications":b [style=dashed, xlabel=" подаёт "];
"insurance_types":b -> "applications":b [style=dashed, xlabel=" выбран в "];
"agents":b -> "applications":b [style=dashed, xlabel=" рассматривает "];
"applications":b -> "policies":b [style=dashed, headlabel="Z", labeldistance=1.6, labelangle=35];
"clients":b -> "policies":b [style=dashed, xlabel=" заключает "];
"agents":b -> "policies":b [style=dashed, xlabel=" оформляет "];
"insurance_types":b -> "policies":b [style=dashed, xlabel=" определяет "];
"policies":b -> "payments":b [style=solid, xlabel=" содержит ", headlabel="P", labeldistance=1.6, labelangle=35];
"policies":b -> "claims":b [style=dashed];
"agents":b -> "claims":b [style=dashed, xlabel=" урегулирует "];
{rank=same; "roles";} {rank=same; "users"; "insurance_types";} {rank=same; "clients"; "agents";}
}