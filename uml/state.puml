@startuml
!include _style.iuml
hide empty description
state "Ожидает оплаты" as W
state "Действует" as A
state "Приостановлен" as S
state "Истёк" as E
state "Расторгнут" as T
state "Исполнен" as F
[*] --> W : договор оформлен\nпо одобренной заявке\nили продлением
W --> A : внесён первый взнос
W --> T : первый взнос не внесён\nв течение 10 дней
A --> S : очередной взнос\nпросрочен
S --> A : задолженность\nпогашена
S --> T : просрочка более 30 дней
A --> T : досрочное расторжение\n[возврат части премии]
S --> T : досрочное расторжение
A --> F : страховая сумма\nисчерпана выплатами
A --> E : наступила дата\nокончания
S --> E : наступила дата\nокончания
T --> [*]
F --> [*]
E --> [*]
note right of E : продление создаёт\nновый договор\nв состоянии «Ожидает оплаты»
@enduml
