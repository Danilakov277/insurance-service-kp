@startuml
!include _style.iuml
hide empty description
[*] --> ОжидаетОплаты : полис оформлен\nпо одобренной заявке
state "Ожидает оплаты" as ОжидаетОплаты
state "Действует" as Действует
state "Приостановлен" as Приостановлен
state "Истёк" as Истёк
state "Расторгнут" as Расторгнут
state "Исполнен" as Исполнен
ОжидаетОплаты --> Действует : внесён первый взнос
ОжидаетОплаты --> Расторгнут : первый взнос не внесён\nв течение 10 дней
Действует --> Приостановлен : очередной взнос\nпросрочен
Приостановлен --> Действует : задолженность\nпогашена
Приостановлен --> Расторгнут : просрочка более 30 дней
Действует --> Расторгнут : досрочное расторжение\n[расчёт возврата премии]
Действует --> Исполнен : страховая сумма\nисчерпана выплатами
Действует --> Истёк : наступила дата\nокончания
Истёк --> Действует : продление договора
Расторгнут --> [*]
Исполнен --> [*]
Истёк --> [*]
@enduml
